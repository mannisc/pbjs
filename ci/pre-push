#!/usr/bin/env sh
# =============================================================================
# git pre-push hook — the everyday gate for the .pb sources.
# =============================================================================
# Install:  ln -sf ../../ci/pre-push .git/hooks/pre-push
# Skip once:  git push --no-verify
#
# This exists because the compiler check cannot run on a GitHub-hosted runner
# (see .github/workflows/ci.yml). For a library this size that is not much of a
# loss: the leak it guards against — pbjs depending on a symbol that only exists
# in the host app it is developed inside — is introduced by the person editing
# pbjs, which is exactly who this hook runs for. It takes well under a second.
#
# Degrades rather than blocks: with no PureBasic installed it runs the
# compiler-free checks and says so, instead of refusing the push.
# =============================================================================

set -eu

repo=$(git rev-parse --show-toplevel)
cd "$repo"

echo "[pre-push] static source checks"
node ci/check-sources.mjs

if [ -d tests/node_modules ]; then
  echo "[pre-push] bridge tests (jsdom)"
  (cd tests && npm test --silent)
else
  echo "[pre-push] tests/node_modules missing — skipping the bridge tests."
  echo "           Install them once:  cd tests && npm ci"
fi

# pbjsClient/ is vendored into the host app that develops it (pbjs lives inside
# that checkout as a git-ignored nested repo, and the host's CI does a plain
# checkout that does not contain pbjs — so the host cannot import from here).
# Two copies therefore exist, and the direction is one-way: edit here, copy out.
# This catches the copies parting company while it is still one command to fix.
#
# Skips rather than fails when the parent checkout is absent, so pbjs stays
# pushable on its own — same policy as the compiler check below.
host_dir=../react/shared/services
if [ -f "$host_dir/pbjsClient.ts" ]; then
  drifted=""
  for f in pbjsClient.ts pbjs.d.ts; do
    if ! diff -q "pbjsClient/$f" "$host_dir/$f" >/dev/null 2>&1; then
      drifted="$drifted $f"
    fi
  done
  if [ -n "$drifted" ]; then
    echo "[pre-push] the vendored copy has drifted:$drifted" >&2
    echo "           Canonical source is THIS repo. Copy out:" >&2
    for f in $drifted; do
      echo "             cp pbjsClient/$f $host_dir/$f" >&2
    done
    exit 1
  fi
  echo "[pre-push] vendored client copy is in sync with the host"
else
  echo "[pre-push] host checkout not found — skipping the vendored-copy check."
fi

if ci/purebasic-home.sh >/dev/null 2>&1; then
  echo "[pre-push] pbcompiler syntax check"
  ci/check-purebasic.sh

  echo "[pre-push] native harnesses"
  tests/pb/run.sh >/dev/null

  # The harness rewrites the fixture the jsdom suite asserts against. A stale
  # committed copy still passes over there, while testing yesterday's wire
  # format — so catch the drift here, where it can still be committed.
  if ! git diff --quiet -- tests/fixtures/native-frames.json; then
    echo "[pre-push] tests/fixtures/native-frames.json changed — the router now" >&2
    echo "           emits different frames. Review and commit it." >&2
    exit 1
  fi
else
  echo "[pre-push] PureBasic not found — skipping the compiler check and the"
  echo "           native harnesses. Set PUREBASIC_HOME to run them. The"
  echo "           self-hosted CI job (.github/workflows/purebasic.yml) covers"
  echo "           this if enabled."
fi

echo "[pre-push] OK"
